# Credenciais da API Tixxi
# Copie este arquivo para `.env` e preencha os valores reais.
VITE_TIXXI_API_KEY=
VITE_TIXXI_EMAIL=
VITE_TIXXI_PASSWORD=

# Credenciais da API oficial de ocorrências do COR
VITE_CORIO_EVENTS_USERNAME=
VITE_CORIO_EVENTS_PASSWORD=

# Base URL da API de ocorrências do COR (opcional).
# Vazio em dev: usa o proxy do Vite definido em vite.config.js.
# Em produção, defina um proxy/gateway próprio (a API oficial não envia CORS).
VITE_CORIO_EVENTS_BASE_URL=

# Credenciais da API Dataprom/Antares (semáforos)
VITE_ANTARES_API_KEY=

# Base URL da API Antares (opcional). Vazio em dev: usa o proxy do Vite.
VITE_ANTARES_BASE_URL=

# Waze for Cities (Partner Hub) — feed de congestionamento e alertas.
# A URL do feed contém o token do parceiro, ou seja, é uma credencial: fica
# SOMENTE no servidor (nunca com prefixo VITE_, que é embutido no bundle).
# Use a URL completa do feed entregue pelo Partner Hub.
WAZE_FEED_URL=
