# Credenciais da API Tixxi
# Copie este arquivo para `.env` e preencha os valores reais.
VITE_TIXXI_API_KEY=
VITE_TIXXI_EMAIL=
VITE_TIXXI_PASSWORD=

# Credenciais da API oficial de ocorrências do COR
VITE_CORIO_EVENTS_USERNAME=
VITE_CORIO_EVENTS_PASSWORD=

# Base URL da API de ocorrências do COR (opcional).
# Vazio em dev: usa o proxy do Vite definido em vite.config.js.
# Em produção, defina um proxy/gateway próprio (a API oficial não envia CORS).
VITE_CORIO_EVENTS_BASE_URL=

# Credenciais da API Dataprom/Antares (semáforos)
# Chave usada somente no servidor/proxy; não prefixar com VITE_.
ANTARES_API_KEY=

# Base URL da API Antares (opcional). Vazio em dev: usa o proxy do Vite.
VITE_ANTARES_BASE_URL=

# Waze for Cities (Partner Hub) — feed de congestionamento e alertas.
# A URL do feed contém o token do parceiro, ou seja, é uma credencial: fica
# SOMENTE no servidor (nunca com prefixo VITE_, que é embutido no bundle).
# Use a URL completa do feed entregue pelo Partner Hub.
WAZE_FEED_URL=

# --- Histórico de métricas e frames ------------------------------------------
# Segredo exigido pelo POST /api/collect. Sem ele o endpoint responde 503, para
# que ninguém possa disparar coletas e encher o banco. Gere um valor aleatório
# longo (ex.: `openssl rand -hex 32`) e use o MESMO valor no agendador.
COLLECT_SECRET=

# Intervalo (em minutos) da coleta automática que o SERVIDOR faz por conta
# própria enquanto está acordado — logo após um deploy e a cada tick, mesmo sem
# chamada externa. É uma rede de segurança para quando o agendador externo
# (GitHub Actions) atrasa. O agendador continua necessário para ACORDAR a
# instância quando ninguém a acessa (no plano free do Render ela hiberna).
# Padrão: 15. Só tem efeito com DATABASE_URL definido.
COLLECT_INTERVAL_MINUTES=15

# Banco do histórico. Com DATABASE_URL o servidor usa o driver Postgres
# (recomendado: Neon/Supabase, que persistem em plano gratuito). Sem ela, cai no
# driver de arquivo JSONL em HISTORY_DIR — só para desenvolvimento local, porque
# em hospedagem com disco efêmero o conteúdo se perde a cada deploy.
#
# No Neon, prefira a conexão POOLED (host com sufixo `-pooler`): o compute
# suspende após 5 min sem uso e o pooler absorve o cold start da primeira query.
# Use também `sslmode=verify-full` no lugar de `sslmode=require`. Hoje o driver
# trata os dois como equivalentes, mas a partir do pg v9 `require` passa a
# adotar a semântica fraca do libpq (não valida o certificado) e a conexão
# ficaria silenciosamente menos segura.
#
# Volume esperado: cada frame tem ~190 KB de JSON (~35 KB comprimido no
# Postgres). A 15 min de cadência são ~96 frames/dia, ou seja, ~100 MB/mês.
DATABASE_URL=

# Diretório do driver de arquivo (apenas desenvolvimento).
HISTORY_DIR=var/history

# Retenção dos frames, em dias (padrão 90). O frame é ~95% do volume do
# histórico (~100 MB/mês), então é a única tabela podada — com 90 dias o estado
# estacionário fica em ~300 MB, dentro do 1 GB do Neon e dos 500 MB do Supabase.
# As tabelas analíticas (occurrence, state_change) NUNCA são podadas.
# Use 0 para desligar a poda (banco com espaço folgado).
HISTORY_RETENTION_DAYS=90

# Credenciais de servidor para o coletor das câmeras do Tixxi.
# OPCIONAIS em desenvolvimento: sem elas o coletor usa as VITE_TIXXI_* acima,
# evitando duplicar o mesmo segredo. Em produção, defina estas.
TIXXI_API_KEY=
TIXXI_EMAIL=
TIXXI_PASSWORD=

# Base URL da API de câmeras (opcional). Padrão: http://10.50.3.96:8000.
# Deixe vazio para usar o padrão.
TIXXI_TARGET=

# Credenciais de servidor para o coletor das ocorrências do COR.
CORIO_EVENTS_USERNAME=
CORIO_EVENTS_PASSWORD=
