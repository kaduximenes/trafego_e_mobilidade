# Credenciais da API Tixxi
# Copie este arquivo para `.env` e preencha os valores reais.
VITE_TIXXI_API_KEY=
VITE_TIXXI_EMAIL=
VITE_TIXXI_PASSWORD=

# Credenciais da API oficial de ocorrências do COR
VITE_CORIO_EVENTS_USERNAME=
VITE_CORIO_EVENTS_PASSWORD=

# Base URL da API de ocorrências do COR (opcional).
# Vazio em dev: usa o proxy do Vite definido em vite.config.js.
# Em produção, defina um proxy/gateway próprio (a API oficial não envia CORS).
VITE_CORIO_EVENTS_BASE_URL=

# Credenciais da API Dataprom/Antares (semáforos)
VITE_ANTARES_API_KEY=

# Base URL da API Antares (opcional). Vazio em dev: usa o proxy do Vite.
VITE_ANTARES_BASE_URL=

# Waze for Cities (CCP) — feed de congestionamento.
# Exige credenciais de parceiro aprovado no programa Waze for Cities.
# Sem estas variáveis o KPI de "Quilômetros de Engarrafamento" fica no estado
# "aguardando API key" (nenhum número simulado é exibido).
VITE_WAZE_API_KEY=
VITE_WAZE_PARTNER_ID=
# Opcional: URL completa do feed, caso o parceiro use um endpoint próprio.
VITE_WAZE_FEED_URL=
# Base URL do feed do Waze (opcional). Vazio em dev: usa o proxy do Vite.
VITE_WAZE_BASE_URL=
